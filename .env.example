# For running the digest on your own machine: copy to .env (git-ignored) and
# fill in. In GitHub these live in Settings > Secrets and variables > Actions.

# --- Secrets ---
ANTHROPIC_API_KEY=
DIGEST_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
# The service account's whole JSON key, on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
YOUTUBE_API_KEY=

# --- Variables (not secret) ---
DISCORD_GUILD_ID=
# Comma-separated: the feedback and bug-report channels (forum or text).
DISCORD_CHANNEL_IDS=
RUN_REPORTS_SHEET_ID=
RUN_REPORTS_RANGE=Form Responses 1
BUG_REPORTS_SHEET_ID=
BUG_REPORTS_RANGE=Form Responses 1
YOUTUBE_CHANNEL_ID=
FIRST_LOOKBACK_DAYS=7
